# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:alpine AS builder
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY go.mod go.sum ./
COPY tests/obs-prod-docker/fixtures ./tests/obs-prod-docker/fixtures
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath \
  -ldflags="-s -w" -o /out/obs-fixtures ./tests/obs-prod-docker/fixtures

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/obs-fixtures /app/obs-fixtures
EXPOSE 8080
ENTRYPOINT ["/app/obs-fixtures"]
