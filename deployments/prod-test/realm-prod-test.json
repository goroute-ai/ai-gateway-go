{
  "realm": "goroute-prod",
  "enabled": true,
  "displayName": "GoRoute Prod-Test Realm",
  "sslRequired": "all",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "ecdsa-generated",
        "providerId": "ecdsa-generated",
        "config": {
          "priority": ["90"],
          "enabled": ["true"],
          "active": ["true"],
          "ecdsaEllipticCurveKey": ["P-256"]
        }
      },
      {
        "name": "eddsa-generated",
        "providerId": "eddsa-generated",
        "config": {
          "priority": ["80"],
          "enabled": ["true"],
          "active": ["true"],
          "eddsaEllipticCurveKey": ["Ed25519"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "goroute-gateway",
      "name": "GoRoute AI Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "goroute-prod-oidc-secret-2026",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://gateway.prod.test:18443/auth/sso/keycloak/callback"
      ],
      "webOrigins": [
        "https://gateway.prod.test:18443"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://gateway.prod.test:18443/ui/",
        "access.token.signed.response.alg": "RS256",
        "id.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": ["basic", "web-origins", "acr", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "goroute-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "goroute-gateway",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "goroute-org-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "goroute-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "goroute_role",
            "claim.name": "role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "goroute-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
